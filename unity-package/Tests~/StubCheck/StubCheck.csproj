<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SYNTAX / TYPE SANITY CHECK ONLY - this is NOT a Unity compile.
    It compiles the UnityEngine-facing runtime scripts against a hand-written minimal stub of the Unity APIs they use
    (Stubs.cs, written from memory of the public API) to catch typos and type errors between our own files.
    A pass here proves nothing about real Unity API compatibility. See Documentation~/TestingStatus.md.
    Run:  dotnet build unity-package/Tests~/StubCheck
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>CS0649;CS0414;CS0169;CS0067;CS8981;CS0108;CS0109</NoWarn>
    <DefineConstants>$(DefineConstants);ENABLE_LEGACY_INPUT_MANAGER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Runtime/**/*.cs" Exclude="../../Runtime/InputSystem/**" />
    <Compile Include="../../Samples~/**/*.cs" />
    <None Include="../../Tests/Editor/Core/Golden/*.json" Link="Golden/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

</Project>
